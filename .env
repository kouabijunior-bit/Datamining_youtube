# ===== Clé YouTube Data API v3 =====
# Mettre DEMO pour travailler hors ligne avec des données simulées.
YT_API_KEY=DEMO

# Pays pour les tendances (CG = Congo-Brazzaville, CD = RDC, FR = France, CI = Côte d'Ivoire...)
REGION_CODE=CG

# Nombre de vidéos suivies en temps réel
TRACK_TOP=15

# ===== Collecte =====
# Secondes entre deux relevés des compteurs
COLLECT_INTERVAL_SECONDS=60
# Les commentaires sont relevés tous les N cycles (économise le quota)
COMMENTS_EVERY_N_CYCLES=10

# ===== Base de données =====
# mysql (recommandé) ou sqlite (aucune installation nécessaire)
DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=30062005
MYSQL_DATABASE=datamining_youtube
SQLITE_PATH=datamining_youtube.db

# Sel secret pour anonymiser les auteurs de commentaires (changer cette valeur !)
ANON_SALT=269122fa701f286b9d5f3b5d67b0c7f85b8abde21649a15fbfae668321aaee1e
